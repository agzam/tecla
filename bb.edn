{:paths ["src"]
 :deps {}
 :tasks
 {build {:doc "Build the C bridge"
         :task (shell "make -C bridge")}

  run {:doc  "Start tecla. Args: [--config PATH] [--port PORT]"
       :override-builtin true
       :depends [build]
       :task (let [start! (requiring-resolve 'tecla.core/start!)
                   args   *command-line-args*
                   pairs  (partition-all 2 args)
                   opts   (reduce (fn [m [k v]]
                                    (case k
                                      "--config" (assoc m :config-path v)
                                      "--port"   (assoc m :nrepl-port (parse-long v))
                                      m))
                                  {} pairs)]
               (apply start! (mapcat identity opts)))}

  test:fsm {:doc "Run FSM unit tests"
            :task (shell "bb test/fsm_test.clj")}

  test:bridge {:doc "Run bridge integration tests (needs uinput access)"
               :depends [build]
               :task (shell "bb test/bridge_test.clj")}

  test:core {:doc "Run core key processing tests"
             :task (shell "bb test/core_test.clj")}

  test:hud {:doc "Run HUD tests (needs eww + display)"
            :task (shell "bb test/hud_test.clj")}

  test {:doc "Run all unit tests"
        :depends [test:fsm test:core]}

  setup:gnome
  {:doc "Install the window-calls GNOME Shell extension (needed for focus-or-launch on GNOME/Wayland)"
   :task
   (let [uuid "window-calls@domandoman.xyz"
         ext-dir (str (System/getProperty "user.home")
                      "/.local/share/gnome-shell/extensions/" uuid)
         info (try (:out (shell {:out :string}
                          "gnome-extensions" "info" uuid))
                   (catch Exception _ nil))
         installed? (and info
                         (re-find (re-pattern "ACTIVE|ENABLED")
                                  (str info)))]
     (if installed?
       (println "window-calls is already installed and active.")
       (let [tmp-dir (str "/tmp/window-calls-" (System/currentTimeMillis))]
         (println "Cloning window-calls from GitHub...")
         (shell "git" "clone" "--depth" "1"
                "https://github.com/ickyicky/window-calls.git" tmp-dir)
         (shell "mkdir" "-p" ext-dir)
         (shell "cp" (str tmp-dir "/extension.js") ext-dir)
         (shell "cp" (str tmp-dir "/metadata.json") ext-dir)
         (shell "rm" "-rf" tmp-dir)
         (println "Enabling extension...")
         (try (shell "gnome-extensions" "enable" uuid)
              (catch Exception _
                (println "Could not enable - you may need to log out and back in first.")))
         (println)
         (println "Done. If the extension doesn't activate, log out and back in."))))}}}
