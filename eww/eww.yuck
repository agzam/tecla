(defvar current-modal-name "")
(defvar current-modal-keys '[]')

(defwindow modal
  :monitor 0
  :geometry (geometry
    :x "30px" :y "30px"
    :width "20%" :height "50px"
    :anchor "top left")
  :stacking "overlay"
  (box :orientation "vertical" :halign "start" :class "modal__window-wrapper"
    (label :text current-modal-name :halign "start" :class "modal__title")
    (box :class "modal__keys-wrapper" :orientation "vertical" :halign "start" :spacing 5
      (for kbd in current-modal-keys
        (box :class "keybinding"
          (label :text "${kbd.key}  ${kbd.desc}" :halign "start"))))))
