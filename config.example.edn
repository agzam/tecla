{;; :compositor :hyprland  ;; auto-detected if not set

 :global-keymap
 {;; --- Remaps (Mac-like) ---
  [:super :c] [:ctrl :c]
  [:super :v] [:ctrl :v]
  [:super :a] [:ctrl :a]
  [:super :z] [:ctrl :z]
  [:super :x] [:ctrl :x]
  [:super :s] [:ctrl :s]
  [:super :w] [:ctrl :w]
  [:super :t] [:ctrl :t]
  [:super :f] [:ctrl :f]

  ;; --- Modal ---
  [:super :space]
  {:desc "Main"
   :keys
   {:a {:desc "Apps"
        :keys {:e {:desc "Emacs"
                   :action (wm/focus-or-launch "Emacs" "emacs")}
               :b {:desc "Brave"
                   :action (wm/focus-or-launch "brave-browser"
                             "brave --enable-features=UseOzonePlatform")}
               :p {:desc "Brave Private"
                   :action (wm/focus-or-launch "initialTitle:New Private Tab.*"
                             "brave --enable-features=UseOzonePlatform --incognito")}
               :s {:desc "Slack"
                   :action (wm/focus-or-launch "Slack")}
               :q {:desc "qBittorrent"
                   :action (wm/focus-or-launch "org.qbittorrent.qBittorrent" "qbittorrent")}}}

    :w {:desc "Windows"
        :keys {:h {:desc "Left"  :action (wm/focus-left)}
               :l {:desc "Right" :action (wm/focus-right)}
               :j {:desc "Down"  :action (wm/focus-down)}
               :k {:desc "Up"    :action (wm/focus-up)}
               :m {:desc "Maximize"   :action (wm/maximize)}
               :c {:desc "Close"      :action (wm/close-window)}
               :r {:desc "Resize" :transient true
                   :keys {:h {:desc "Shrink W" :action (wm/resize-active -20 0)}
                          :l {:desc "Grow W"   :action (wm/resize-active 20 0)}
                          :j {:desc "Grow H"   :action (wm/resize-active 0 20)}
                          :k {:desc "Shrink H" :action (wm/resize-active 0 -20)}}}}}

    :m {:desc "Media"
        :keys {:k {:desc "Vol Up"   :action "pactl set-sink-volume @DEFAULT_SINK@ +5%"}
               :j {:desc "Vol Down" :action "pactl set-sink-volume @DEFAULT_SINK@ -5%"}
               :m {:desc "Mute"     :action "pactl set-sink-mute @DEFAULT_SINK@ toggle"}
               :space {:desc "Play/Pause" :action "playerctl play-pause"}
               :l {:desc "Next"     :action "playerctl next"}
               :h {:desc "Prev"     :action "playerctl previous"}}}}}}}
